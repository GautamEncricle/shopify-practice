{% if section.settings.collection != blank %}
  {% assign collection = collections[section.settings.collection] %}
  {% assign products = collection.products | slice: 0, section.settings.product_limits %}

  <div class="custom-product-list">
    {% for product in products %}
      <div class="product-card">
        <a href="{{ product.url }}">
          <img src="{{ product.featured_image | image_url: 'medium' }}" alt="{{ product.title }}">
          <h3>{{ product.title }}</h3>
          <p>{{ product.price | money }}</p>
        </a>
      </div>
    {% endfor %}
  </div>
{% else %}
  <p>Please provide collections</p>
{% endif %}

{% schema %}
{
  "name": "Custom product section",
  "settings": [
    {
      "type" : "collection",
      "id" : "collection",
      "label" : "Chose the collection"
    },
    {
      "type": "number",
      "id": "product_limits",
      "label": "Enter the products limits",
      "default": 4
    }
  ],
  "presets": [
    {
      "name" : "Custom product section"
    }
  ]
}
{% endschema %}
