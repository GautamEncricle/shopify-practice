{% if section.settings.collection != blank %}
  {% assign collection = collection[section.settings.collection] %}
  {% assign products = collection.products | slice: 0, section.settings.product_limit %}

  <div class="product-grid">
    {% for product in products %}
      {% render 'product-card', product: product %}
    {% endfor %}
  </div>
{% else %}
  <p>Please select the collection</p>
{% endif %}

{% stylesheet %}
  .product-grid{
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
  }
  .product-card{
    border: 1px solid #ccc;
    padding: 16px;
    text-align: center;
    border-radius: 10px;
  }
  .product-title{
    font-size: 1.1rem;
    margin: 10px 0;
  }
  .add-to-card-btn{
    background-color: #000;
    color: #fff;
    padding: 8px 12px;
    border: none;
    cursor: pointer;
  }
  .sold-out{
    color: red;
    font-weight: 500;
    size: 25px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom products",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Select the collection"
    },
   {
      "type": "number",
      "id": "product_limit",
      "label": "Number of Products",
      "default": 4
    },
  ],
  "presets": [
    {
      "name": "Custom Products"
    }
  ]
}
{% endschema %}
