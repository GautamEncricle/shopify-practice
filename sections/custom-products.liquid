{% if section.settings.collection != blank %}
  {% assign collection = collection[section.settings.collection] %}
  {% assign products = collection.products | slice: 0, section.settings.product_limit %}

  <div class="product-grid">
    {% for product in products %}
      {% render 'product-card', product: product %}
    {% endfor %}
  </div>
{% else %}
  <p>Please select the collection</p>
{% endif %}

{% schema %}
{
  "name": "Custom products",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Select the collection"
    },
   {
      "type": "number",
      "id": "product_limit",
      "label": "Number of Products",
      "default": 4
    },
  ],
  "presets": [
    {
      "name": "Custom Products"
    }
  ]
}
{% endschema %}
