<h1>{{ section.settings.textlabel }}</h1>

{% schema %}
{
  "name": "Custom section",

  "settings": [
    {
      "type": "text",
      "id" : "textlabel",
      "default": "Enter some text here.",
      "label" : "Heading"
    }
  ],
  "presets": [{
    "name" : "Custom section",
  }]
}
{% endschema %}

{% stylesheet %}
  h1{
    text-align: center;
  }
{% endstylesheet %}
