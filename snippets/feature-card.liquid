<div class="feature-card">
  <div class="feature-icon">
    {% assign valid_icons = 'image,product,collection,avatar,store,text,logo' | split: ',' %}
    {% if icon != blank and valid_icons contains icon %}
      {{ icon | placeholder_svg_tag }}
    {% else %}
      {{ 'image' | placeholder_svg_tag }}
    {% endif %}
  </div>
  <h3>{{ title }}</h3>
  <p>{{ description }}</p>
</div>

<style>
  .feature-card {
    padding: 20px;
    border: 1px solid #e1e1e1;
    border-radius: 8px;
    text-align: center;
  }
  .feature-icon svg {
    width: 50px;
    height: 50px;
  }
</style>